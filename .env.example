DATABASE_URL=your-database-url-here
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
# ── Internal Service Keys (Granular RBAC Capabilities) ──────────────────────────
# SERVICE_API_KEY is limited to orders:create and payments:create.
SERVICE_API_KEY=your-secret-chatbot-key-here
SERVICE_ORDERS_READ_KEY=       # orders:read (GET /orders/{order_id}, GET /orders/latest)
SERVICE_ORDERS_CANCEL_KEY=     # orders:cancel (POST /orders/{order_id}/cancel)
SERVICE_CUSTOMERS_KEY=         # customers:manage (/customers, /admin/takeover-handlers)
SERVICE_REFUND_KEY=            # refunds:request (POST /orders/{order_id}/refund)
SERVICE_PAYMENT_STATUS_KEY=    # payments:read (GET /payments/{order_id}/status)
SERVICE_FINANCIAL_SUMMARY_KEY= # reports:summary (GET /reports/financial-summary)
SERVICE_OWNER_NUMBERS_KEY=     # owners:read (GET /admin/owner-numbers)
SERVICE_SETTLEMENT_KEY=        # settlements:check (POST /payments/check-expired-settlements)
SERVICE_WA_VERIFICATION_KEY=   # identity:verify (WhatsApp registration links POST /auth/verify/wa/confirm)
MIDTRANS_MERCHANT_ID=your-midtrans-merchant-id-here
MIDTRANS_CLIENT_KEY=your-midtrans-client-key-here
MIDTRANS_SERVER_KEY=your-midtrans-server-key-here
CHATBOT_URL=http://localhost:8000
INTERNAL_API_KEY=your-internal-api-key-here
CHATBOT_WA_NUMBER=your-chatbot-whatsapp-number-here
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Toti Cakery
SMTP_USE_TLS=true
SMTP_OPERATIONAL_INBOX=
EMAIL_OUTBOX_POLL_SECONDS=5
EMAIL_OUTBOX_MAX_ATTEMPTS=10
EMAIL_OUTBOX_LEASE_SECONDS=300
EMAIL_OUTBOX_ADMIN_TOKEN=
